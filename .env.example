# Copy to .env.local and fill in. Never commit real values.
# Only the public (browser-safe) Supabase URL and publishable key belong here.
# Never put a service-role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scaffold pages (profile, documents, AI, academy, community, ...) are hidden in
# production unless this is "true". They are placeholders, not working features.
NEXT_PUBLIC_ENABLE_SCAFFOLD_PAGES=false

# Find Chatbot (website). Build-time flag; off by default.
NEXT_PUBLIC_ENABLE_CHATBOT=false

# WhatsApp Business Cloud API webhook (SERVER-ONLY secrets: never prefix with NEXT_PUBLIC_).
# The webhook returns 503 until ALL of these are set. Not verified end to end.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_SITE_URL=
